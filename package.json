{
  "name": "cli-task-manager",
  "version": "1.0.0",
  "description": "Gerenciador de tarefas em linha de comando (CLI) em Node.js ESM",
  "type": "module",
  "bin": {
    "tarefas": "./bin/tarefas.js"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "quality-gate": "node scripts/quality-gate.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "cli",
    "task-manager",
    "nodejs",
    "esm"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.21.0",
    "vitest": "^3.0.7"
  }
}
